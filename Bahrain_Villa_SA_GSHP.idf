! ==============================================================================
! CONSTRUCTIONS
! ==============================================================================
Construction,
    Wall_External,           !- Name
    Plaster_20mm,            !- Layer 1 (outside)
    Concrete_200mm,          !- Layer 2
    Insulation_50mm,         !- Layer 3
    Plaster_20mm;            !- Layer 4 (inside)

Construction,
    Roof_External,           !- Name
    Concrete_Roof_150mm,     !- Layer 1 (outside)
    Roof_Insulation_75mm,    !- Layer 2
    Screed_50mm;             !- Layer 3 (inside)

Construction,
    Floor_Internal,          !- Name
    Floor_Tile_10mm,         !- Layer 1 (top)
    Floor_Concrete_100mm,    !- Layer 2
    Floor_Insulation_50mm;   !- Layer 3 (bottom)

WindowMaterial:SimpleGlazingSystem,
    Glazing_Double_LowE,     !- Name
    1.8,                     !- U-Factor {W/m2-K}
    0.25,                    !- Solar Heat Gain Coefficient
    0.65;                    !- Visible Transmittance

Construction,
    Window_Construction,     !- Name
    Glazing_Double_LowE;     !- Outside Layer

