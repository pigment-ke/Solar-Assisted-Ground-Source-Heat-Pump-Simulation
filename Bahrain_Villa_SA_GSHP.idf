! ==============================================================================
! GROUND HEAT EXCHANGER — 4 boreholes x 100 m (TRNSYS Type 557 equivalent)
! Bahrain ground properties: k=2.0 W/m-K, Cp_vol=2.0e6 J/m3-K, UGT=30 C
! ==============================================================================
GroundHeatExchanger:Vertical:Properties,
    GHX_Props,               !- Name
    1.0,                     !- Depth of Top of Borehole {m}
    100.0,                   !- Borehole Length {m}
    0.150,                   !- Borehole Diameter {m}
    1.0,                     !- Grout Thermal Conductivity {W/m-K}
    1.0E6,                   !- Grout Thermal Heat Capacity {J/m3-K}
    0.4,                     !- Pipe Thermal Conductivity {W/m-K}
    1.5E6,                   !- Pipe Thermal Heat Capacity {J/m3-K}
    0.020,                   !- Pipe Outer Diameter {m}
    0.002,                   !- Pipe Thickness {m}
    0.040;                   !- U-Tube Distance {m}

GroundHeatExchanger:Vertical:Single,
    BH_1,                    !- Name
    GHX_Props,               !- GHE:Vertical:Properties Object Name
    0,                       !- X Location {m}
    0;                       !- Y Location {m}

GroundHeatExchanger:Vertical:Single,
    BH_2,                    !- Name
    GHX_Props,               !- GHE:Vertical:Properties Object Name
    5,                       !- X Location {m}
    0;                       !- Y Location {m}

GroundHeatExchanger:Vertical:Single,
    BH_3,                    !- Name
    GHX_Props,               !- GHE:Vertical:Properties Object Name
    0,                       !- X Location {m}
    5;                       !- Y Location {m}

GroundHeatExchanger:Vertical:Single,
    BH_4,                    !- Name
    GHX_Props,               !- GHE:Vertical:Properties Object Name
    5,                       !- X Location {m}
    5;                       !- Y Location {m}

GroundHeatExchanger:Vertical:Array,
    GHX_Array,               !- Name
    GHX_Props,               !- Ground Heat Exchanger Vertical Properties Object Name
    2,                       !- Number of Boreholes in X-Direction
    2,                       !- Number of Boreholes in Y-Direction
    5.0;                     !- Borehole Spacing {m}

GroundHeatExchanger:System,
    Ground_HX,               !- Name
    GHX_Inlet_Node,          !- Inlet Node Name
    GHX_Outlet_Node,         !- Outlet Node Name
    0.002,                   !- Design Flow Rate {m3/s}  (0.5 L/s per borehole x4)
    Site:GroundTemperature:Undisturbed:KusudaAchenbach, !- Undisturbed Ground Temperature Model Type
    Bahrain_Ground_Temp,     !- Undisturbed Ground Temperature Model Name
    2.0,                     !- Ground Thermal Conductivity {W/m-K}
    2.0E6,                   !- Ground Thermal Heat Capacity {J/m3-K}
    ,                        !- GHE:Vertical:ResponseFactors Object Name
    UHFcalc,                 !- g-Function Calculation Method
    ,                        !- GHE:Vertical:Sizing Object Type
    ,                        !- GHE:Vertical:Sizing Object Name
    GHX_Array;               !- GHE:Vertical:Array Object Name

Site:GroundTemperature:Undisturbed:KusudaAchenbach,
    Bahrain_Ground_Temp,     !- Name
    2.0,                     !- Soil Thermal Conductivity {W/m-K}
    1920,                    !- Soil Density {kg/m3}
    1060,                    !- Soil Specific Heat {J/kg-K}
    30.0,                    !- Average Soil Surface Temperature {C}
    3.0,                     !- Average Amplitude of Surface Temperature {C}
    15;                      !- Phase Shift of Minimum Surface Temperature {days}

Site:GroundTemperature:Deep,
    30.0,                    !- January Deep Ground Temperature {C}
    30.0,                    !- February Deep Ground Temperature {C}
    30.0,                    !- March Deep Ground Temperature {C}
    30.0,                    !- April Deep Ground Temperature {C}
    30.0,                    !- May Deep Ground Temperature {C}
    30.0,                    !- June Deep Ground Temperature {C}
    30.0,                    !- July Deep Ground Temperature {C}
    30.0,                    !- August Deep Ground Temperature {C}
    30.0,                    !- September Deep Ground Temperature {C}
    30.0,                    !- October Deep Ground Temperature {C}
    30.0,                    !- November Deep Ground Temperature {C}
    30.0;                    !- December Deep Ground Temperature {C}

Site:GroundTemperature:BuildingSurface,
    25.0,                    !- January Ground Temperature {C}
    25.0,                    !- February Ground Temperature {C}
    25.0,                    !- March Ground Temperature {C}
    25.0,                    !- April Ground Temperature {C}
    25.0,                    !- May Ground Temperature {C}
    25.0,                    !- June Ground Temperature {C}
    25.0,                    !- July Ground Temperature {C}
    25.0,                    !- August Ground Temperature {C}
    25.0,                    !- September Ground Temperature {C}
    25.0,                    !- October Ground Temperature {C}
    25.0,                    !- November Ground Temperature {C}
    25.0;                    !- December Ground Temperature {C}

! ==============================================================================
! WATER-TO-WATER HEAT PUMP (ground-source, equation-fit)
! Sizing: ~25 kW cooling capacity for 300 m2 Bahrain villa
! Equation-fit coefficients from ASHRAE RP-1244 (generic WW HP, water-cooled)
! ==============================================================================
Curve:QuadLinear,
    GSHP_Cool_Cap_Curve,     !- Name
    -9.32564313298629,       !- Coefficient1 Constant
    11.088084240584,         !- Coefficient2 w
    -1.75195196204063,       !- Coefficient3 x
    0.760820340847872,       !- Coefficient4 y
    0.0,                     !- Coefficient5 z
    -100, 100,               !- Minimum/Maximum Value of w
    -100, 100,               !- Minimum/Maximum Value of x
    0, 100,                  !- Minimum/Maximum Value of y
    0, 100,                  !- Minimum/Maximum Value of z
    0, 38;                   !- Minimum/Maximum Curve Output

Curve:QuintLinear,
    GSHP_Cool_Sens_Cap_Curve,!- Name
    -5.26562830117273,       !- Coefficient1 Constant
    17.3118017582604,        !- Coefficient2 v
    -11.4496890368762,       !- Coefficient3 w
    -0.944804890543481,      !- Coefficient4 x
    0.739606605780884,       !- Coefficient5 y
    0.0,                     !- Coefficient6 z
    -100, 100,               !- Minimum/Maximum Value of v
    -100, 100,               !- Minimum/Maximum Value of w
    -100, 100,               !- Minimum/Maximum Value of x
    0, 100,                  !- Minimum/Maximum Value of y
    0, 100,                  !- Minimum/Maximum Value of z
    0, 38;                   !- Minimum/Maximum Curve Output

Curve:QuadLinear,
    GSHP_Cool_Power_Curve,   !- Name
    -3.25323327026219,       !- Coefficient1 Constant
    -0.990977022339372,      !- Coefficient2 w
    4.03828937789764,        !- Coefficient3 x
    0.952179101682919,       !- Coefficient4 y
    0.0,                     !- Coefficient5 z
    -100, 100,               !- Minimum/Maximum Value of w
    -100, 100,               !- Minimum/Maximum Value of x
    0, 100,                  !- Minimum/Maximum Value of y
    0, 100,                  !- Minimum/Maximum Value of z
    0, 38;                   !- Minimum/Maximum Curve Output

Curve:QuadLinear,
    GSHP_Heat_Cap_Curve,     !- Name
    -1.30782327125798,       !- Coefficient1 Constant
    -2.37467612404102,       !- Coefficient2 w
    4.00919247797279,        !- Coefficient3 x
    0.615580752610271,       !- Coefficient4 y
    0.0,                     !- Coefficient5 z
    -100, 100,               !- Minimum/Maximum Value of w
    -100, 100,               !- Minimum/Maximum Value of x
    0, 100,                  !- Minimum/Maximum Value of y
    0, 100,                  !- Minimum/Maximum Value of z
    0, 38;                   !- Minimum/Maximum Curve Output

Curve:QuadLinear,
    GSHP_Heat_Power_Curve,   !- Name
    -2.17352461285805,       !- Coefficient1 Constant
    0.830808361346509,       !- Coefficient2 w
    1.5682782658283,         !- Coefficient3 x
    0.689709515714146,       !- Coefficient4 y
    0.0,                     !- Coefficient5 z
    -100, 100,               !- Minimum/Maximum Value of w
    -100, 100,               !- Minimum/Maximum Value of x
    0, 100,                  !- Minimum/Maximum Value of y
    0, 100,                  !- Minimum/Maximum Value of z
    0, 38;                   !- Minimum/Maximum Curve Output

Curve:Quadratic,
    GSHP_PLF_Curve,          !- Name
    0.85,                    !- Coefficient1 Constant
    0.15,                    !- Coefficient2 x
    0.0,                     !- Coefficient3 x**2
    0.0,                     !- Minimum Value of x
    1.0;                     !- Maximum Value of x

! --- Cooling mode coil (load side) ---
Coil:Cooling:WaterToAirHeatPump:EquationFit,
    GSHP_Cooling_Coil,       !- Name
    ,                        !- Availability Schedule Name
    GSHP_Cooling_Coil_WaterIn,  !- Water Inlet Node Name
    GSHP_Cooling_Coil_WaterOut, !- Water Outlet Node Name
    GSHP_Cooling_Coil_AirIn, !- Air Inlet Node Name
    GSHP_Cooling_Coil_AirOut,!- Air Outlet Node Name
    Autosize,                !- Rated Air Flow Rate {m3/s}
    0.00556,                 !- Rated Water Flow Rate {m3/s}
    Autosize,                !- Rated Total Cooling Capacity {W}
    Autosize,                !- Rated Sensible Cooling Capacity {W}
    5.0,                     !- Rated Cooling Coefficient of Performance
    30.0,                    !- Rated Entering Water Temperature {C}
    27.0,                    !- Rated Entering Air Dry-Bulb Temperature {C}
    19.0,                    !- Rated Entering Air Wet-Bulb Temperature {C}
    GSHP_Cool_Cap_Curve,     !- Total Cooling Capacity Curve Name
    GSHP_Cool_Sens_Cap_Curve,!- Sensible Cooling Capacity Curve Name
    GSHP_Cool_Power_Curve,   !- Cooling Power Consumption Curve Name
    GSHP_PLF_Curve,          !- Part Load Fraction Correlation Curve Name
    0,                       !- Nominal Time for Condensate Removal to Begin {s}
    0,                       !- Ratio of Initial Moisture Evaporation Rate and Steady State Latent Capacity
    2.5,                     !- Maximum Cycling Rate {cycles/hr}
    60,                      !- Latent Capacity Time Constant {s}
    60;                      !- Fan Delay Time {s}

! --- Heating mode coil (load side) ---
Coil:Heating:WaterToAirHeatPump:EquationFit,
    GSHP_Heating_Coil,       !- Name
    ,                        !- Availability Schedule Name
    GSHP_Heating_Coil_WaterIn,  !- Water Inlet Node Name
    GSHP_Heating_Coil_WaterOut, !- Water Outlet Node Name
    GSHP_Cooling_Coil_AirOut,!- Air Inlet Node Name
    GSHP_Heating_Coil_AirOut,!- Air Outlet Node Name
    Autosize,                !- Rated Air Flow Rate {m3/s}
    0.00556,                 !- Rated Water Flow Rate {m3/s}
    Autosize,                !- Rated Heating Capacity {W}
    4.0,                     !- Rated Heating Coefficient of Performance
    20.0,                    !- Rated Entering Water Temperature {C}
    20.0,                    !- Rated Entering Air Dry-Bulb Temperature {C}
    0.88,                    !- Ratio of Rated Heating Capacity to Rated Cooling Capacity
    GSHP_Heat_Cap_Curve,     !- Heating Capacity Curve Name
    GSHP_Heat_Power_Curve,   !- Heating Power Consumption Curve Name
    GSHP_PLF_Curve;          !- Part Load Fraction Correlation Curve Name

! ==============================================================================
! SUPPLEMENTAL ELECTRIC HEATING COIL (required by ZoneHVAC:WaterToAirHeatPump)
! Small capacity — Bahrain winters are mild (min ~12°C), heating rarely needed
! ==============================================================================
Coil:Heating:Electric,
    GSHP_Supp_Heating_Coil,  !- Name
    ,                        !- Availability Schedule Name (always on)
    1.0,                     !- Efficiency
    3000,                    !- Nominal Capacity {W}
    GSHP_Heating_Coil_AirOut,!- Air Inlet Node Name
    GSHP_Supply_Node,        !- Air Outlet Node Name
    ;                        !- Temperature Setpoint Node Name

! ==============================================================================
! FAN (on-off, inside ZoneHVAC:WaterToAirHeatPump)
! ==============================================================================
Fan:OnOff,
    GSHP_Fan,                !- Name
    Always_On,               !- Availability Schedule Name
    0.75,                    !- Fan Total Efficiency
    250,                     !- Pressure Rise {Pa}
    Autosize,                !- Maximum Flow Rate {m3/s}
    0.9,                     !- Motor Efficiency
    1.0,                     !- Motor In Airstream Fraction
    GSHP_Return_Node,        !- Air Inlet Node Name
    GSHP_Cooling_Coil_AirIn; !- Air Outlet Node Name

! ==============================================================================
! ZONE HVAC: WATER-TO-AIR HEAT PUMP (correct EnergyPlus object for zone GSHP)
! FIXED: All fields present, valid object names for coils, no "None"/"NoLimit"
! ==============================================================================
ZoneHVAC:WaterToAirHeatPump,
    Villa_GSHP_Unit,         !- Name
    Always_On,               !- Availability Schedule Name
    GSHP_Return_Node,        !- Air Inlet Node Name
    GSHP_Supply_Node,        !- Air Outlet Node Name
    ,                        !- Outdoor Air Mixer Object Type
    ,                        !- Outdoor Air Mixer Name
    Autosize,                !- Cooling Supply Air Flow Rate {m3/s}
    Autosize,                !- Heating Supply Air Flow Rate {m3/s}
    0,                       !- Supply Air Flow Rate When No Cooling or Heating is Needed {m3/s}
    No,                      !- No Load Supply Air Flow Rate Control Set To Low Speed
    0,                       !- Outdoor Air Flow Rate During Cooling Operation {m3/s}
    0,                       !- Outdoor Air Flow Rate During Heating Operation {m3/s}
    0,                       !- Outdoor Air Flow Rate When No Cooling or Heating is Needed {m3/s}
    Fan:OnOff,               !- Supply Air Fan Object Type
    GSHP_Fan,                !- Supply Air Fan Name
    Coil:Heating:WaterToAirHeatPump:EquationFit, !- Heating Coil Object Type
    GSHP_Heating_Coil,       !- Heating Coil Name
    Coil:Cooling:WaterToAirHeatPump:EquationFit, !- Cooling Coil Object Type
    GSHP_Cooling_Coil,       !- Cooling Coil Name
    Coil:Heating:Electric,   !- Supplemental Heating Coil Object Type
    GSHP_Supp_Heating_Coil,  !- Supplemental Heating Coil Name
    50,                      !- Maximum Supply Air Temperature from Supplemental Heater {C}
    21,                      !- Maximum Outdoor Dry-Bulb Temperature for Supplemental Heater Operation {C}
    ,                        !- Outdoor Dry-Bulb Temperature Sensor Node Name
    BlowThrough,             !- Fan Placement
    Always_On,               !- Supply Air Fan Operating Mode Schedule Name
    ,                        !- Availability Manager List Name
    Cycling;                 !- Heat Pump Coil Water Flow Mode

ZoneHVAC:EquipmentList,
    Villa_Equipment_List,    !- Name
    SequentialLoad,          !- Load Distribution Scheme
    ZoneHVAC:WaterToAirHeatPump, !- Zone Equipment Object Type 1
    Villa_GSHP_Unit,         !- Zone Equipment Name 1
    1,                       !- Zone Equipment Cooling Sequence 1
    1;                       !- Zone Equipment Heating or No-Load Sequence 1

ZoneHVAC:EquipmentConnections,
    Villa_Living,            !- Zone Name
    Villa_Equipment_List,    !- Zone Conditioning Equipment List Name
    GSHP_Supply_Node,        !- Zone Air Inlet Node or NodeList Name
    GSHP_Return_Node,        !- Zone Air Exhaust Node or NodeList Name
    Villa_Living_Zone_Node,  !- Zone Air Node Name
    Villa_Living_Return_Node;!- Zone Return Air Node or NodeList Name

! ==============================================================================
! PLANT LOOPS
! Three loops:
!   1. Chilled/Hot Water Loop (load side of HP → zone fan-coil-style coils)
!   2. Ground Loop (source side of HP → GHX)
! The ZoneHVAC:WaterToAirHeatPump object internally manages both sides,
! so we need one PlantLoop for the source (ground) side.
! ==============================================================================

! --- Ground (condenser/source) loop ---
PlantLoop,
    Ground_Loop,             !- Name
    Water,                   !- Fluid Type
    ,                        !- User Defined Fluid Type
    Ground_Loop_Operation,   !- Plant Equipment Operation Scheme Name
    GHX_Outlet_Node,         !- Loop Temperature Setpoint Node Name
    80,                      !- Maximum Loop Temperature {C}
    5,                       !- Minimum Loop Temperature {C}
    0.002,                   !- Maximum Loop Flow Rate {m3/s}
    0,                       !- Minimum Loop Flow Rate {m3/s}
    autocalculate,           !- Plant Loop Volume {m3}
    Ground_Loop_Supply_Inlet,!- Plant Side Inlet Node Name
    Ground_Loop_Supply_Outlet,!- Plant Side Outlet Node Name
    Ground_Loop_Supply_Branches, !- Plant Side Branch List Name
    Ground_Loop_Supply_Connectors, !- Plant Side Connector List Name
    Ground_Loop_Demand_Inlet,!- Demand Side Inlet Node Name
    Ground_Loop_Demand_Outlet,!- Demand Side Outlet Node Name
    Ground_Loop_Demand_Branches, !- Demand Side Branch List Name
    Ground_Loop_Demand_Connectors, !- Demand Side Connector List Name
    SequentialLoad,          !- Load Distribution Scheme
    ,                        !- Availability Manager List Name
    SingleSetpoint,          !- Plant Loop Demand Calculation Scheme
    ;                        !- Common Pipe Simulation

Sizing:Plant,
    Ground_Loop,             !- Plant or Condenser Loop Name
    Condenser,               !- Loop Type
    35.0,                    !- Design Loop Exit Temperature {C}
    5.0;                     !- Loop Design Temperature Difference {deltaC}

SetpointManager:FollowGroundTemperature,
    Ground_Loop_Setpoint_Mgr,!- Name
    Temperature,             !- Control Variable
    Site:GroundTemperature:Deep, !- Reference Ground Temperature Object Type
    5.0,                     !- Offset Temperature Difference {deltaC}
    80.0,                    !- Maximum Setpoint Temperature {C}
    5.0,                     !- Minimum Setpoint Temperature {C}
    GHX_Outlet_Node;         !- Setpoint Node or NodeList Name

PlantEquipmentOperationSchemes,
    Ground_Loop_Operation,   !- Name
    PlantEquipmentOperation:Uncontrolled, !- Control Scheme Object Type 1
    Ground_Loop_Uncontrolled,!- Control Scheme Name 1
    Always_On;               !- Control Scheme Schedule Name 1

PlantEquipmentOperation:Uncontrolled,
    Ground_Loop_Uncontrolled,!- Name
    Ground_Loop_GHX_List;    !- Equipment List Name

PlantEquipmentList,
    Ground_Loop_GHX_List,    !- Name
    GroundHeatExchanger:System, !- Equipment Object Type 1
    Ground_HX;               !- Equipment Name 1

! Ground loop supply side branches/connectors
BranchList,
    Ground_Loop_Supply_Branches, !- Name
    Ground_Loop_Supply_Inlet_Branch,
    Ground_Loop_GHX_Branch,
    Ground_Loop_Supply_Outlet_Branch;

Branch,
    Ground_Loop_Supply_Inlet_Branch, !- Name
    ,                        !- Pressure Drop Curve Name
    Pump:ConstantSpeed,      !- Component Object Type 1
    Ground_Loop_Pump,        !- Component Name 1
    Ground_Loop_Supply_Inlet,!- Inlet Node Name 1
    Ground_Loop_Pump_Outlet; !- Outlet Node Name 1

Branch,
    Ground_Loop_GHX_Branch,  !- Name
    ,                        !- Pressure Drop Curve Name
    GroundHeatExchanger:System, !- Component Object Type 1
    Ground_HX,               !- Component Name 1
    GHX_Inlet_Node,          !- Inlet Node Name 1
    GHX_Outlet_Node;         !- Outlet Node Name 1

Branch,
    Ground_Loop_Supply_Outlet_Branch, !- Name
    ,                        !- Pressure Drop Curve Name
    Pipe:Adiabatic,          !- Component Object Type 1
    Ground_Loop_Supply_Outlet_Pipe, !- Component Name 1
    Ground_Loop_Supply_Outlet_Pipe_Inlet, !- Inlet Node Name 1
    Ground_Loop_Supply_Outlet; !- Outlet Node Name 1

ConnectorList,
    Ground_Loop_Supply_Connectors, !- Name
    Connector:Splitter,      !- Connector Object Type 1
    Ground_Loop_Supply_Splitter, !- Connector Name 1
    Connector:Mixer,         !- Connector Object Type 2
    Ground_Loop_Supply_Mixer;!- Connector Name 2

Connector:Splitter,
    Ground_Loop_Supply_Splitter, !- Name
    Ground_Loop_Supply_Inlet_Branch, !- Inlet Branch Name
    Ground_Loop_GHX_Branch;  !- Outlet Branch Name 1

Connector:Mixer,
    Ground_Loop_Supply_Mixer,!- Name
    Ground_Loop_Supply_Outlet_Branch, !- Outlet Branch Name
    Ground_Loop_GHX_Branch;  !- Inlet Branch Name 1

! Ground loop demand side (GSHP source water connections)
BranchList,
    Ground_Loop_Demand_Branches, !- Name
    Ground_Loop_Demand_Inlet_Branch,
    Ground_Loop_GSHP_Cooling_Branch,
    Ground_Loop_GSHP_Heating_Branch,
    Ground_Loop_Demand_Outlet_Branch;

Branch,
    Ground_Loop_Demand_Inlet_Branch, !- Name
    ,
    Pipe:Adiabatic,          !- Component Object Type 1
    Ground_Loop_Demand_Inlet_Pipe, !- Component Name 1
    Ground_Loop_Demand_Inlet,!- Inlet Node Name 1
    Ground_Loop_Demand_Inlet_Pipe_Outlet; !- Outlet Node Name 1

Branch,
    Ground_Loop_GSHP_Cooling_Branch, !- Name
    ,
    Coil:Cooling:WaterToAirHeatPump:EquationFit, !- Component Object Type 1
    GSHP_Cooling_Coil,       !- Component Name 1
    GSHP_Cooling_Coil_WaterIn, !- Inlet Node Name 1
    GSHP_Cooling_Coil_WaterOut; !- Outlet Node Name 1

Branch,
    Ground_Loop_GSHP_Heating_Branch, !- Name
    ,
    Coil:Heating:WaterToAirHeatPump:EquationFit, !- Component Object Type 1
    GSHP_Heating_Coil,       !- Component Name 1
    GSHP_Heating_Coil_WaterIn, !- Inlet Node Name 1
    GSHP_Heating_Coil_WaterOut; !- Outlet Node Name 1

Branch,
    Ground_Loop_Demand_Outlet_Branch, !- Name
    ,
    Pipe:Adiabatic,          !- Component Object Type 1
    Ground_Loop_Demand_Outlet_Pipe, !- Component Name 1
    Ground_Loop_Demand_Outlet_Pipe_Inlet, !- Inlet Node Name 1
    Ground_Loop_Demand_Outlet; !- Outlet Node Name 1

ConnectorList,
    Ground_Loop_Demand_Connectors, !- Name
    Connector:Splitter,      !- Connector Object Type 1
    Ground_Loop_Demand_Splitter, !- Connector Name 1
    Connector:Mixer,         !- Connector Object Type 2
    Ground_Loop_Demand_Mixer;!- Connector Name 2

Connector:Splitter,
    Ground_Loop_Demand_Splitter, !- Name
    Ground_Loop_Demand_Inlet_Branch,
    Ground_Loop_GSHP_Cooling_Branch,
    Ground_Loop_GSHP_Heating_Branch;

Connector:Mixer,
    Ground_Loop_Demand_Mixer,!- Name
    Ground_Loop_Demand_Outlet_Branch,
    Ground_Loop_GSHP_Cooling_Branch,
    Ground_Loop_GSHP_Heating_Branch;

! ==============================================================================
! PUMP (ground loop)
! ==============================================================================
Pump:ConstantSpeed,
    Ground_Loop_Pump,        !- Name
    Ground_Loop_Supply_Inlet,!- Inlet Node Name
    Ground_Loop_Pump_Outlet, !- Outlet Node Name
    0.002,                   !- Rated Flow Rate {m3/s}
    179352,                  !- Rated Pump Head {Pa}  (18 m head, typical GHX)
    500,                     !- Rated Power Consumption {W}
    0.87,                    !- Motor Efficiency
    0.0,                     !- Fraction of Motor Inefficiencies to Fluid Stream
    ,                        !- Pump Control Type (default Intermittent)
    ;                        !- Pump Flow Rate Schedule Name

! ==============================================================================
! PIPES (adiabatic bypass pipes required by EnergyPlus branch structure)
! ==============================================================================
Pipe:Adiabatic,
    Ground_Loop_Supply_Outlet_Pipe,
    Ground_Loop_Supply_Outlet_Pipe_Inlet,
    Ground_Loop_Supply_Outlet;

Pipe:Adiabatic,
    Ground_Loop_Demand_Inlet_Pipe,
    Ground_Loop_Demand_Inlet,
    Ground_Loop_Demand_Inlet_Pipe_Outlet;

Pipe:Adiabatic,
    Ground_Loop_Demand_Outlet_Pipe,
    Ground_Loop_Demand_Outlet_Pipe_Inlet,
    Ground_Loop_Demand_Outlet;

! ==============================================================================
! OUTPUT VARIABLES
! ==============================================================================
Output:Variable,
    Villa_Living,
    Zone Mean Air Temperature,
    Hourly;

Output:Variable,
    Villa_Living,
    Zone Air Relative Humidity,
    Hourly;

Output:Variable,
    Villa_Living,
    Zone Thermostat Cooling Setpoint Temperature,
    Hourly;

Output:Variable,
    Villa_Living,
    Zone Mechanical Ventilation Current Density Volume Flow Rate,
    Hourly;

Output:Variable,
    *,
    Site Outdoor Air Drybulb Temperature,
    Hourly;

Output:Variable,
    *,
    Site Diffuse Solar Radiation Rate per Area,
    Hourly;

Output:Variable,
    *,
    Site Direct Solar Radiation Rate per Area,
    Hourly;

Output:Variable,
    Ground_HX,
    Ground Heat Exchanger Average Borehole Temperature,
    Hourly;

Output:Variable,
    Ground_HX,
    Ground Heat Exchanger Heat Transfer Rate,
    Hourly;

Output:Variable,
    Ground_HX,
    Ground Heat Exchanger Inlet Temperature,
    Hourly;

Output:Variable,
    Ground_HX,
    Ground Heat Exchanger Outlet Temperature,
    Hourly;

Output:Variable,
    GSHP_Cooling_Coil,
    Cooling Coil Total Cooling Rate,
    Hourly;

Output:Variable,
    GSHP_Heating_Coil,
    Heating Coil Heating Rate,
    Hourly;

Output:Variable,
    Villa_GSHP_Unit,
    Zone Water to Air Heat Pump Total Cooling Rate,
    Hourly;

Output:Variable,
    Villa_GSHP_Unit,
    Zone Water to Air Heat Pump Total Heating Rate,
    Hourly;

Output:Variable,
    Ground_Loop_Pump,
    Pump Fluid Heat Gain Rate,
    Hourly;

Output:Meter,
    Electricity:Facility,
    Hourly;

Output:Meter,
    Cooling:Electricity,
    Hourly;

Output:Meter,
    Heating:Electricity,
    Hourly;

Output:Table:SummaryReports,
    AllSummary;

OutputControl:Table:Style,
    HTML;

! ==============================================================================
! END OF FILE
